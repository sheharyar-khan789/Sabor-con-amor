# Sabor con Amor — environment variables
# Copy to .env.local (git-ignored) and fill in values from the Sabor con Amor
# Firebase project's Console. Never reuse values from the Sadiq Pearl reference project.
# Never commit real values. Never put server secrets in NEXT_PUBLIC_* variables.

# --- Firebase web app config (public by design; protected by Security Rules) ---
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY — secret) ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy three fields from the downloaded JSON, then DELETE the JSON file (never commit it).
# Keep the private key on one line with literal \n sequences, wrapped in double quotes.
# Not needed on Firebase App Hosting / Cloud Run, which provide credentials automatically.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Public site address (REQUIRED for production builds) ---
# The confirmed production domain, https only, no trailing slash, e.g. https://example.com
# Used for canonical URLs, the sitemap, robots.txt, Open Graph URLs and structured data.
# If unset, a PLACEHOLDER address is used and the production build prints a warning.
NEXT_PUBLIC_SITE_URL=

# --- Security switches (server only unless NEXT_PUBLIC_) — all OFF / safe when empty ---
# Super Admin two-step sign-in (TOTP authenticator app). Set to true ONLY after
# Identity Platform + TOTP MFA are enabled on the Firebase project (see
# ARCHITECTURE.md, "Authentication"). When true, an admin without a second
# factor gets no admin access.
SABOR_ADMIN_MFA_REQUIRED=
# Firebase App Check (reCAPTCHA Enterprise). The site key is public; leave both
# empty until a real key is registered for the production domain. Enforcement
# needs BOTH the key and SABOR_APPCHECK_ENFORCE=true.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
SABOR_APPCHECK_ENFORCE=
# Salt for the hashed user / IP ids in the security log (any long random
# string, kept in the host's secret store). A default is used when empty.
SECURITY_LOG_SALT=

# --- Local development only: Firebase Emulator Suite ---
# Leave these unset in production.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
